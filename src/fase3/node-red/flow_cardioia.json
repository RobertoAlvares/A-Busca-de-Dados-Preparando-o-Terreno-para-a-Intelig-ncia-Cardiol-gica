  {
    "id": "fn_fog",
    "type": "function",
    "z": "tab_cardioia",
    "name": "Regras de fog: valida, reconcilia alerta, data a leitura",
    "func": "// Camada de fog: nao confia cegamente no dispositivo.\n// 1) valida faixa fisica; 2) recalcula o alerta com os MESMOS limiares do\n//    ESP32 (defesa em profundidade); 3) reconstroi o horario real da coleta\n//    para leituras que ficaram no buffer offline.\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null || d.temp === undefined || d.bpm === undefined) {\n    node.warn('payload invalido descartado');\n    return null;\n}\nif (d.temp < 25 || d.temp > 45 || d.bpm < 0 || d.bpm > 250) {\n    node.warn('leitura fora da faixa fisica descartada: ' + JSON.stringify(d));\n    return null;\n}\n\nconst LIM = { febre: 38.0, hipo: 35.0, taqui: 120, bradi: 50 };\nconst motivos = [];\nif (d.temp > LIM.febre) motivos.push('febre');\nif (d.temp < LIM.hipo) motivos.push('hipotermia');\nif (d.bpm === 0) motivos.push('sem_pulso');\nelse if (d.bpm > LIM.taqui) motivos.push('taquicardia');\nelse if (d.bpm < LIM.bradi) motivos.push('bradicardia');\nconst alertaFog = motivos.length ? motivos.join(';') : 'normal';\nif (alertaFog !== d.alerta) {\n    node.warn('divergencia de alerta: dispositivo=' + d.alerta + ' fog=' + alertaFog);\n}\n\n// Sem RTC no ESP32: horario da coleta = agora - tempo que ficou guardada.\nconst ts = Date.now() - (d.atraso_s || 0) * 1000;\n\n// Contadores de sessao (para o painel)\nconst recebidas = (context.get('recebidas') || 0) + 1;\ncontext.set('recebidas', recebidas);\nconst doBuffer = (context.get('doBuffer') || 0) + (d.origem === 'buffer' ? 1 : 0);\ncontext.set('doBuffer', doBuffer);\n\nconst info = {\n    payload: `seq ${d.seq} | origem: ${d.origem} | atraso: ${d.atraso_s}s | ` +\n             `recebidas: ${recebidas} (do buffer: ${doBuffer}) | descartadas no dispositivo: ${d.descartadas}`\n};\n\nconst alerta = { payload: alertaFog, temp: d.temp, bpm: d.bpm, ts: ts };\n\nreturn [\n    { payload: d.bpm, topic: 'BPM', timestamp: ts },\n    { payload: d.temp, topic: 'Temperatura (C)', timestamp: ts },\n    { payload: d.temp },\n    { payload: d.bpm },\n    alerta,\n    info\n];",
    "outputs": 6,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 120,
    "wires": [["ui_chart_bpm"], ["ui_chart_temp"], ["ui_gauge_temp"], ["ui_gauge_bpm"], ["ui_alerta", "sw_so_alerta"], ["ui_info"]]
  },
